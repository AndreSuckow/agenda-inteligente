# Porta da API local
PORT=3001

# Pasta opcional que armazenará agenda.db
# DATA_DIR=./data

# Configure estes valores para testar login e dados compartilhados via Supabase.
# A chave publishable/anon é pública; nunca coloque a service_role no frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
